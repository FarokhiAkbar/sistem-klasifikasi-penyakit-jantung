# Salin file ini menjadi .env dan isi dengan nilai yang sesuai
# JANGAN isi file .env ke git!

# Flask Secret Key
SECRET_KEY=ganti-dengan-secret-key-yang-kuat

# Database MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=db_heart_prediction

# Gemini API Key
# Dapatkan dari: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=masukkan-api-key-gemini-anda-di-sini
